#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
checkout_kind="file"
if [[ "${3:-0}" == "1" ]]; then
  checkout_kind="branch"
fi
"$repo_root/bin/auto-reconcile-main" --root "$repo_root" --source-hook post-checkout --checkout-kind "$checkout_kind"
