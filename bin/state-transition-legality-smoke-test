#!/usr/bin/env bash
set -euo pipefail

EXECPLAN_PATH=".agent/execplans/20260316-subgame-branch-state-transition-governance-codex-01-execplan.md"

echo "[1/3] state-transition legality report"
TRANSITION_JSON="$(bin/state-transition-legality-check --execplan-path "$EXECPLAN_PATH")"
echo "$TRANSITION_JSON"
printf '%s\n' "$TRANSITION_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["command"]=="state-transition-legality-check"; assert data["status"]=="ok"; assert data["branch_role"]=="impl_execplan_root"; assert data["active_node"]["node_id"]=="rwg-023"'

echo "[2/3] policy compliance state-transition integration"
POLICY_JSON="$(bin/policy-compliance-check --execplan-path "$EXECPLAN_PATH")"
echo "$POLICY_JSON"
printf '%s\n' "$POLICY_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["status"]=="ok"; assert data["checks"]["state_transition"]["ok"] is True'

echo "[3/3] orchestrator state-transition surface"
STATUS_JSON="$(bin/orchestrator-status --execplan "$EXECPLAN_PATH" || true)"
echo "$STATUS_JSON"
printf '%s\n' "$STATUS_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["checks"]["state_transition"]["status"]=="ok"'

echo "state-transition legality smoke test completed"
