#!/usr/bin/env bash
set -euo pipefail

commands=(
  "bin/execplan-validate .agent/execplans/*.md"
  "bin/sync-todos"
  "bin/repo-health-check"
  "bin/execplan-test"
)

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '[' > "$tmp"
first=1
overall=0
for cmd in "${commands[@]}"; do
  set +e
  out="$(bash -lc "$cmd" 2>&1)"
  code=$?
  set -e
  if [[ $first -eq 0 ]]; then
    printf ',' >> "$tmp"
  fi
  first=0
  python3 - "$cmd" "$code" "$out" >> "$tmp" <<'PY'
import json
import sys
cmd = sys.argv[1]
code = int(sys.argv[2])
output = sys.argv[3]
print(json.dumps({"command": cmd, "exit_code": code, "output": output}, sort_keys=True))
PY
  if [[ $code -eq 2 ]]; then
    overall=2
  elif [[ $code -ne 0 && $overall -ne 2 ]]; then
    overall=1
  fi
done
printf ']' >> "$tmp"

python3 - "$tmp" "$overall" <<'PY'
import json
import sys
report_path = sys.argv[1]
overall = int(sys.argv[2])
commands = json.loads(open(report_path, encoding="utf-8").read())
print(json.dumps({"tool": "run_local_ci", "overall_exit": overall, "commands": commands}, indent=2, sort_keys=True))
PY

exit "$overall"
