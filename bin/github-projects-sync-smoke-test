#!/usr/bin/env bash
set -euo pipefail

EXECPLAN_PATH=".agent/execplans/20260311-github-projects-provider-sync-runtime-codex-01-execplan.md"
ROOT="$(mktemp -d)"
FIELD_MAP_PATH="$ROOT/artifacts/provider-sync/github-projects-field-map.json"

cleanup() {
  rm -rf "$ROOT"
}
trap cleanup EXIT

mkdir -p "$ROOT/spec/providers" "$ROOT/artifacts/planner/research" "$ROOT/.agent/execplans" "$ROOT/artifacts/provider-sync"

python3 - <<'PY' "$ROOT" "$FIELD_MAP_PATH"
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
field_map_path = Path(sys.argv[2])

(root / "spec" / "remaining-work-graph.schema.yaml").write_text("version: 1\n", encoding="utf-8")
(root / "spec" / "provider-adapter.schema.yaml").write_text(
    "\n".join(
        [
            "version: v1",
            "provider_adapter:",
            "  required_fields:",
            "    - provider",
            "    - projection_kind",
            "    - authority_mode",
            "    - identity_field",
            "    - supported_entities",
            "    - exported_fields",
            "    - conflict_policy",
            "    - human_portable",
            "    - agent_portable",
            "  authority_mode_allowed:",
            "    - projection_only",
            "  projection_kind_allowed:",
            "    - remaining_work_board",
        ]
    )
    + "\n",
    encoding="utf-8",
)
(root / "spec" / "providers" / "github-projects.schema.yaml").write_text(
    "\n".join(
        [
            "version: v1",
            "provider: github_projects",
            "projection_kind: remaining_work_board",
            "board_model:",
            "  board_scope: remaining_work_graph",
            "  item_identity_field: node_id",
            "  item_type: slice_node",
            "field_map:",
            "  node_id: text",
            "  title: title",
            "  target_execplan_id: text",
            "  status: single_select",
            "  gating_class: single_select",
            "  implementation_branch: text",
            "  goal_area: single_select",
            "  dependency_summary: text",
            "  human_review_state: single_select",
            "  pr_url: text",
            "  validation_status: single_select",
            "  smoke_status: single_select",
            "  merge_readiness: single_select",
            "  finalization_state: single_select",
            "status_options:",
            "  - ready",
            "  - blocked",
            "  - review_gated",
            "  - decision_gated",
            "  - completed",
            "gating_class_options:",
            "  - auto_runnable",
            "  - review_gated",
            "  - decision_gated",
            "goal_area_options:",
            "  - provider-sync",
            "  - governance",
            "human_review_state_options:",
            "  - not_requested",
            "  - ready_for_review",
            "  - in_review",
            "  - merged",
            "validation_status_options:",
            "  - pending",
            "  - passed",
            "  - failed",
            "smoke_status_options:",
            "  - pending",
            "  - passed",
            "  - failed",
            "merge_readiness_options:",
            "  - local_only",
            "  - ready",
            "  - blocked",
            "finalization_state_options:",
            "  - not_finalized",
            "  - merged_to_main",
            "bootstrap:",
            "  provider_managed_fields:",
            "    - status",
            "sync:",
            "  provider_managed_value_map:",
            "    status:",
            "      ready: Todo",
            "      blocked: In Progress",
            "      review_gated: In Progress",
            "      decision_gated: In Progress",
            "      completed: Done",
        ]
    )
    + "\n",
    encoding="utf-8",
)
(root / ".agent" / "execplans" / "github-projects-sync.md").write_text(
    "---\nid: \"20260311-github-projects-provider-sync-runtime-codex-01-execplan\"\n---\n",
    encoding="utf-8",
)
(root / "artifacts" / "planner" / "research" / "remaining-work-graph.json").write_text(
    json.dumps(
        {
            "graph_id": "remaining-work-graph-20260311",
            "created_at": "2026-03-11T00:00:00Z",
            "nodes": [
                {
                    "node_id": "rwg-005",
                    "title": "Provider sync runtime",
                    "status": "ready",
                    "gating_class": "auto_runnable",
                    "conflict_domains": ["provider-sync"],
                    "target_execplan_id": "20260311-github-projects-provider-sync-runtime-codex-01-execplan",
                    "goal_area": "provider-sync",
                    "implementation_branch": "impl-execplan/provider-sync",
                }
            ],
            "edges": [],
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
field_map_path.write_text(
    json.dumps(
        {
            "project_id": "PVT_123",
            "fields": {
                "title": {"field_id": "builtin:title", "data_type": "title"},
                "node_id": {"field_id": "FIELD_node_id", "data_type": "text"},
                "target_execplan_id": {"field_id": "FIELD_target_execplan_id", "data_type": "text"},
                "status": {
                    "field_id": "FIELD_status",
                    "data_type": "single_select",
                    "provider_managed": True,
                    "options": {"Todo": "OPT_TODO", "In Progress": "OPT_PROGRESS", "Done": "OPT_DONE"},
                },
                "gating_class": {"field_id": "FIELD_gating", "data_type": "single_select", "options": {"auto_runnable": "OPT_AUTO"}},
                "implementation_branch": {"field_id": "FIELD_branch", "data_type": "text"},
                "goal_area": {"field_id": "FIELD_goal", "data_type": "single_select", "options": {"provider-sync": "OPT_PROVIDER"}},
                "dependency_summary": {"field_id": "FIELD_dep", "data_type": "text"},
                "human_review_state": {"field_id": "FIELD_review", "data_type": "single_select", "options": {"ready_for_review": "OPT_RFR"}},
                "pr_url": {"field_id": "FIELD_pr", "data_type": "text"},
                "validation_status": {"field_id": "FIELD_validation", "data_type": "single_select", "options": {"passed": "OPT_PASSED"}},
                "smoke_status": {"field_id": "FIELD_smoke", "data_type": "single_select", "options": {"passed": "OPT_PASSED"}},
                "merge_readiness": {"field_id": "FIELD_merge", "data_type": "single_select", "options": {"local_only": "OPT_LOCAL"}},
                "finalization_state": {"field_id": "FIELD_final", "data_type": "single_select", "options": {"not_finalized": "OPT_NOT_FINAL"}},
            },
            "item_ids_by_node_id": {},
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY

echo "[1/3] execplan validation"
bin/execplan-validate "$EXECPLAN_PATH"

echo "[2/3] github projects sync dry run"
SYNC_JSON="$(bin/github-projects-sync --root "$ROOT" --field-map-path "$FIELD_MAP_PATH" --execplan "$ROOT/.agent/execplans/github-projects-sync.md")"
echo "$SYNC_JSON"
printf '%s\n' "$SYNC_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["command"]=="github-projects-sync"; assert data["ok"] is True; assert data["dry_run"] is True; assert data["create_count"] == 1; status_update = next(item for item in data["operations"][0]["field_updates"] if item["field_name"]=="status"); assert status_update["provider_value"]=="Todo"; assert status_update["option_id"]=="OPT_TODO"'

echo "[3/3] focused pytest"
uv run pytest tests/test_github_projects_sync.py

echo "github projects sync smoke test completed"
