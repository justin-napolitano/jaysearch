#!/usr/bin/env bash
set -euo pipefail

echo "[1/2] finalize-execplan focused tests"
uv run pytest tests/test_finalize_execplan.py

echo "[2/2] finalize-execplan merge reconciliation smoke"
PYTHONPATH="$(pwd)/src${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json
import subprocess
import tempfile
from pathlib import Path

from platform_tools.finalize_execplan import finalize_execplan


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def git(root: Path, *args: str) -> None:
    subprocess.run(["git", *args], cwd=root, check=True, capture_output=True, text=True)


with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    git(root, "init", "-b", "main")
    git(root, "config", "user.name", "Smoke")
    git(root, "config", "user.email", "smoke@example.com")

    write(
        root / ".agent" / "AGENTS.md",
        """# AGENTS.md

Initial human maintainer:

github:justin-napolitano
""",
    )
    write(root / "README.md", "base\n")
    git(root, "add", ".")
    git(root, "commit", "--no-gpg-sign", "-m", "docs: base")

    branch = "impl-execplan/20260312-smoke-plan-codex-01-execplan-codex-01-20260312"
    git(root, "checkout", "-b", branch)
    plan = root / ".agent" / "execplans" / "20260312-smoke-plan-codex-01-execplan.md"
    write(
        plan,
        f"""---
id: "20260312-smoke-plan-codex-01-execplan"
title: "Smoke plan"
owner: "agent/codex-01"
created: "2026-03-12T00:00:00Z"
status: draft
base_branch: main
changes:
  - .agent/execplans/20260312-smoke-plan-codex-01-execplan.md
approve_policy: codeowners
reviewers:
  - "github:justin-napolitano"
draft_by: "agent/codex-01"
draft_branch: "{branch}"
draft_created: "2026-03-12T00:00:00Z"
finalized_by: ""
finalized_at: ""
finalized_in_pr: ""
validation:
  tests:
    - name: "execplan-validate"
      command: "bin/execplan-validate .agent/execplans/20260312-smoke-plan-codex-01-execplan.md"
      expected_exit: 0
tasks:
  - title: "Smoke"
    priority: "P1"
depends_on: []
---

# Purpose / Big Picture

Smoke.

## Progress

- [ ] Smoke

## Surprises & Discoveries

None.

## Decision Log

None.

## Outcomes & Retrospective

Smoke.

## Context and Orientation

Smoke.

## Plan of Work

Smoke.

## Concrete Steps

1. Smoke.

## Validation and Acceptance

Smoke.

## Idempotence and Recovery

Smoke.

## Artifacts and Notes

Smoke.

## Interfaces and Dependencies

Smoke.
""",
    )
    git(root, "add", str(plan.relative_to(root)))
    git(root, "commit", "--no-gpg-sign", "-m", "docs(execplan): add smoke plan")
    git(root, "checkout", "main")
    git(
        root,
        "merge",
        "--no-ff",
        "--no-gpg-sign",
        branch,
        "-m",
        f"Merge pull request #90 from JNA31A_AIT/{branch}",
    )

    report = finalize_execplan(path=plan, repo_root=root, derive_from_merge=True, main_ref="main")
    if report["status"] != "completed":
        raise SystemExit(json.dumps(report, indent=2, sort_keys=True))
    print(json.dumps({"command": "finalize-execplan", "status": "ok", "finalized_in_pr": report["finalized_in_pr"]}, sort_keys=True))
PY

echo "finalize-execplan smoke test completed"
