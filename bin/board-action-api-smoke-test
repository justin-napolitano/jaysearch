#!/usr/bin/env bash
set -euo pipefail

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "[1/3] board action api check"
REPORT_JSON="$(bin/board-action-api-check)"
echo "$REPORT_JSON"
printf '%s\n' "$REPORT_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["command"]=="board-action-api-check"; assert data["status"]=="ok"; assert "implementation_branch_publish" in data["action_family_ids"]'

echo "[2/3] deterministic event write"
cat > "$TMP_DIR/record.json" <<'JSON'
{
  "event_id": "evt-smoke-001",
  "transition_id": "tr-smoke-001",
  "timestamp": "2026-03-16T00:00:00Z",
  "actor_id": "agent/codex-01",
  "actor_class": "agent",
  "action_id": "act-smoke-001",
  "action_family": "implementation_branch_publish",
  "object_id": "rwg-021",
  "source_state": "review_gated",
  "target_state": "ready",
  "decision": "accepted",
  "decision_reason": "published_branch_detected",
  "requested_mutation_surfaces": ["queue_projection", "remaining_work_graph"],
  "applied_mutation_surfaces": ["remaining_work_graph", "queue_projection"],
  "canonical_artifact_refs": ["docs/queued-execplans.md", "artifacts/planner/research/remaining-work-graph.json"],
  "git_evidence_refs": ["refs/heads/impl-execplan/test", "commit:abc123"],
  "github_evidence_refs": ["pr:82"]
}
JSON
WRITE_JSON="$(bin/board-action-event-log-write --event-log "$TMP_DIR/board-action-events.jsonl" --record-json "$TMP_DIR/record.json")"
echo "$WRITE_JSON"
python3 - <<'PY' "$TMP_DIR"
import json
import sys
from pathlib import Path

tmp = Path(sys.argv[1])
written = json.loads((tmp / "board-action-events.jsonl").read_text(encoding="utf-8").splitlines()[0])
assert written["canonical_artifact_refs"] == sorted(written["canonical_artifact_refs"])
assert written["requested_mutation_surfaces"] == sorted(written["requested_mutation_surfaces"])
assert written["decision"] == "accepted"
PY

echo "[3/3] event write response"
printf '%s\n' "$WRITE_JSON" | python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["command"]=="board-action-event-log-write"; assert data["ok"] is True; assert data["record"]["event_id"]=="evt-smoke-001"'

echo "board action api smoke test completed"
